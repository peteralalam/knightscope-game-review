{
  "name": "knightscope-game-review",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/chess-review.test.mjs tests/rating-model.test.mjs tests/engine-pipeline.test.mjs tests/brilliant-suite.test.mjs tests/engine-assets.test.mjs tests/sampler.test.mjs tests/outcome-model.test.mjs tests/rendered-html.test.mjs tests/stockfish-smoke.test.mjs",
    "vendor:stockfish": "node scripts/vendor-stockfish.mjs",
    "build:opening-book": "node scripts/build-opening-book.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/stockfish",
    "db:generate": "drizzle-kit generate",
    "corpus:report": "node scripts/corpus/write-report.mjs",
    "corpus:suite": "node scripts/corpus/brilliant-suite.mjs --preset balanced --json data/brilliant-suite/report.json"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stockfish": "19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
